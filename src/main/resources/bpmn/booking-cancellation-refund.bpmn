        <di:waypoint x="522" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_RefundChangedToState" bpmnElement="Flow_RefundChangedToState">
        <di:waypoint x="1092" y="420" />
        <di:waypoint x="970" y="420" />
