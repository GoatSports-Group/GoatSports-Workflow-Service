      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_AutoApproveToRefund" bpmnElement="Flow_AutoApproveToRefund">
        <di:waypoint x="558" y="180" />
        <di:waypoint x="670" y="180" />
        <di:waypoint x="670" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_CreatedToState" bpmnElement="Flow_CreatedToState">
        <di:waypoint x="860" y="280" />
        <di:waypoint x="920" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_DeadlineToAutoApprove" bpmnElement="Flow_DeadlineToAutoApprove">
        <di:waypoint x="430" y="222" />
