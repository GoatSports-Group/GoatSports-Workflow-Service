<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_BookingCancellationRefund" targetNamespace="http://goatsports.click/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Message_Decided" name="BookingCancellationDecided">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=cancellationId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_RefundStatusChanged" name="RefundStatusChanged">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=refundId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_CancellationMissing" name="Cancellation missing" errorCode="CANCELLATION_NOT_FOUND" />
  <bpmn:process id="Process_BookingCancellationRefund" name="Hủy đặt sân và hoàn tiền" isExecutable="true">
    <bpmn:exclusiveGateway id="Gateway_ReviewMode" name="Cần chủ sân duyệt?" default="Flow_ToOwnerReview">
      <bpmn:incoming>Flow_StartToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_Automatic</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToOwnerReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Approved" name="Chấp thuận" sourceRef="Gateway_Decision" targetRef="Gateway_HasRefund">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:receiveTask id="Task_WaitOwnerDecision" name="Chờ chủ sân duyệt" messageRef="Message_Decided">
      <bpmn:incoming>Flow_ToOwnerReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecision</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Chủ sân chấp thuận?" default="Flow_Rejected">
      <bpmn:incoming>Flow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToOwnerReview" name="Chủ sân duyệt" sourceRef="Gateway_ReviewMode" targetRef="Task_WaitOwnerDecision" />
    <bpmn:sequenceFlow id="Flow_StillRefunding" name="Chưa" sourceRef="Gateway_Refunded" targetRef="Event_RefundStatusChanged" />
    <bpmn:sequenceFlow id="Flow_HasRefund" name="Có" sourceRef="Gateway_HasRefund" targetRef="Task_CreateRefund">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=refundAmount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_HasRefund" name="Có tiền hoàn?" default="Flow_NoRefund">
      <bpmn:incoming>Flow_Automatic</bpmn:incoming>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_AutoApproveToRefund</bpmn:incoming>
      <bpmn:outgoing>Flow_HasRefund</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoRefund</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Refunded" name="Đã hoàn tiền">
      <bpmn:incoming>Flow_Refunded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Refunded" name="Đã hoàn xong?" default="Flow_StillRefunding">
      <bpmn:incoming>Flow_StateToRefunded</bpmn:incoming>
      <bpmn:outgoing>Flow_Refunded</bpmn:outgoing>
      <bpmn:outgoing>Flow_StillRefunding</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Approved" name="Đã hủy">
      <bpmn:incoming>Flow_ApprovedToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Reminded" name="Đã nhắc">
      <bpmn:incoming>Flow_RemindToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Rejected" name="Đã từ chối">
      <bpmn:incoming>Flow_RejectedToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ApprovedToEnd" sourceRef="Task_StateApproved" targetRef="EndEvent_Approved" />
    <bpmn:sequenceFlow id="Flow_AutoApproveToRefund" sourceRef="Event_AutoApprove" targetRef="Gateway_HasRefund" />
    <bpmn:sequenceFlow id="Flow_CreatedToState" sourceRef="Task_CreateRefund" targetRef="Task_StateRefund" />
    <bpmn:sequenceFlow id="Flow_DeadlineToAutoApprove" sourceRef="Timer_PlayStarts" targetRef="Event_AutoApprove" />
    <bpmn:sequenceFlow id="Flow_RefundChangedToState" sourceRef="Event_RefundStatusChanged" targetRef="Task_StateRefund" />
    <bpmn:sequenceFlow id="Flow_RejectedToEnd" sourceRef="Task_StateRejected" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_RemindToEnd" sourceRef="Task_RemindOwner" targetRef="EndEvent_Reminded" />
    <bpmn:sequenceFlow id="Flow_StartToReview" sourceRef="StartEvent_Requested" targetRef="Gateway_ReviewMode" />
    <bpmn:sequenceFlow id="Flow_StateToRefunded" sourceRef="Task_StateRefund" targetRef="Gateway_Refunded" />
    <bpmn:sequenceFlow id="Flow_ToDecision" sourceRef="Task_WaitOwnerDecision" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_ToRemind" sourceRef="Timer_RemindOwner" targetRef="Task_RemindOwner" />
    <bpmn:serviceTask id="Task_StateRefund" name="Ghi trạng thái hoàn tiền">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking-cancellation.apply-state" retries="5" />
        <zeebe:ioMapping>
          <zeebe:input source="=if refundStatus = &#34;SUCCEEDED&#34; then &#34;REFUNDED&#34; else if refundStatus = &#34;FAILED&#34; then &#34;REFUND_FAILED&#34; else if refundStatus = &#34;AWAITING_CLAIM&#34; then &#34;REFUND_AWAITING_CLAIM&#34; else if refundStatus = &#34;AWAITING_BANK_ACCOUNT&#34; then &#34;REFUND_AWAITING_BANK_ACCOUNT&#34; else if refundStatus = &#34;MANUAL_REVIEW&#34; then &#34;REFUND_MANUAL_REVIEW&#34; else &#34;REFUND_PROCESSING&#34;" target="status" />
          <zeebe:output source="=status" target="status" />
          <zeebe:output source="=statusVersion" target="statusVersion" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreatedToState</bpmn:incoming>
      <bpmn:incoming>Flow_RefundChangedToState</bpmn:incoming>
      <bpmn:outgoing>Flow_StateToRefunded</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StateApproved" name="Ghi trạng thái: Đã hủy, không hoàn">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking-cancellation.apply-state" retries="5" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;APPROVED&#34;" target="status" />
          <zeebe:output source="=status" target="status" />
          <zeebe:output source="=statusVersion" target="statusVersion" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoRefund</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovedToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StateRejected" name="Ghi trạng thái: Từ chối">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking-cancellation.apply-state" retries="5" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;REJECTED&#34;" target="status" />
          <zeebe:output source="=status" target="status" />
          <zeebe:output source="=statusVersion" target="statusVersion" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectedToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_NoRefund" name="Không" sourceRef="Gateway_HasRefund" targetRef="Task_StateApproved" />
    <bpmn:startEvent id="StartEvent_Requested" name="Người chơi yêu cầu hủy">
      <bpmn:outgoing>Flow_StartToReview</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_RemindOwner" name="Nhắc chủ sân duyệt">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking-cancellation.remind-owner" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRemind</bpmn:incoming>
      <bpmn:outgoing>Flow_RemindToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_RefundStatusChanged" name="payment-service đổi trạng thái khoản hoàn">
      <bpmn:incoming>Flow_StillRefunding</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundChangedToState</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_RefundStatusChanged" messageRef="Message_RefundStatusChanged" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_Refunded" name="Rồi" sourceRef="Gateway_Refunded" targetRef="EndEvent_Refunded">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=refundStatus = "SUCCEEDED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:boundaryEvent id="Timer_RemindOwner" name="Sau 6 giờ" cancelActivity="false" attachedToRef="Task_WaitOwnerDecision">
      <bpmn:outgoing>Flow_ToRemind</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_RemindOwner">
        <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">PT6H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_CreateRefund" name="Tạo khoản hoàn (payment-service)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="booking-cancellation.create-refund" retries="5" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HasRefund</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatedToState</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Timer_PlayStarts" name="Tới giờ chơi" attachedToRef="Task_WaitOwnerDecision">
      <bpmn:outgoing>Flow_DeadlineToAutoApprove</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_PlayStarts">
        <bpmn:timeDate xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=playStartAt</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Event_AutoApprove" name="Tự chấp thuận">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=true" target="approved" />
          <zeebe:output source="=&#34;Tự động chấp thuận vì chủ sân không phản hồi trước giờ chơi.&#34;" target="decisionNote" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DeadlineToAutoApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApproveToRefund</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_Rejected" name="Từ chối" sourceRef="Gateway_Decision" targetRef="Task_StateRejected" />
    <bpmn:sequenceFlow id="Flow_Automatic" name="Tự duyệt" sourceRef="Gateway_ReviewMode" targetRef="Gateway_HasRefund">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=reviewMode = "AUTOMATIC"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:subProcess id="SubProcess_CancellationMissing" name="Yêu cầu hủy không còn trong venue-service" triggeredByEvent="true">
      <bpmn:endEvent id="EndEvent_CancellationMissing" name="Bỏ qua">
        <bpmn:incoming>Flow_MissingToEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_MissingToEnd" sourceRef="StartEvent_CancellationMissing" targetRef="EndEvent_CancellationMissing" />
      <bpmn:startEvent id="StartEvent_CancellationMissing" name="Không tìm thấy yêu cầu hủy">
        <bpmn:outgoing>Flow_MissingToEnd</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_CancellationMissing" errorRef="Error_CancellationMissing" />
      </bpmn:startEvent>
    </bpmn:subProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BookingCancellationRefund">
    <bpmndi:BPMNPlane id="Plane_BookingCancellationRefund" bpmnElement="Process_BookingCancellationRefund">
